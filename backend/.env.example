# ==========================================
# Blue Panda E-Commerce — Backend Environment Template
# ==========================================
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or production credentials to Git.

# Application Environment: 'development', 'test', or 'production'
ENVIRONMENT=development

# PostgreSQL Database Connection
# In Docker: postgresql+psycopg2://ecommerce_user:GoPassword_123!@postgres:5432/ecommerce_db
# Local host: postgresql+psycopg2://ecommerce_user:GoPassword_123!@localhost:5433/ecommerce_db
DATABASE_URL=postgresql+psycopg2://ecommerce_user:GoPassword_123!@localhost:5433/ecommerce_db

# Database Initialization & Seeding (Development only)
AUTO_INIT_DB=true
SEED_DEMO_DATA=true

# JWT Signing Secret (REQUIRED in production, minimum 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev_secret_key_change_me_super_secure_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Session rollout: keep modern issuance OFF until every old API worker is drained.
# Bearer-only clients retain ACCESS_TOKEN_EXPIRE_MINUTES; refresh opt-in is rejected.
AUTH_ISSUE_SESSION_TOKENS=false
AUTH_ACCEPT_LEGACY_TOKENS=true
# Approve a UTC legacy cutoff separately before setting AUTH_LEGACY_ACCEPT_UNTIL.

# CORS Allowed Origins (Comma-separated string or JSON list)
# In development: defaults to localhost:3000, localhost:8000, 10.0.2.2:8000
# In production: MUST be explicit trusted origins without wildcard, e.g.:
# CORS_ORIGINS=["https://store.bluepanda.com","https://admin.bluepanda.com"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:3001","http://10.0.2.2:8000"]

# Interactive Documentation (/docs and /redoc - disabled in production by default)
ENABLE_DOCS_IN_PRODUCTION=false

# Account Recovery Email (SMTP or SendGrid)
EMAIL_PROVIDER=auto
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Blue Panda
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SENDGRID_API_KEY=
PASSWORD_RESET_EXPIRE_MINUTES=30
STOREFRONT_BASE_URL=http://localhost:3000
MANAGEMENT_BASE_URL=http://localhost:3001

# Digital Card Payments (Stripe — Credit / Debit Card + Cash on Delivery)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Durable Media Uploads (auto | local | supabase | s3)
UPLOAD_STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

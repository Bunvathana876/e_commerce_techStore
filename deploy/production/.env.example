# Blue Panda production deployment template.
# Copy to deploy/production/.env only on the target host and replace every
# REPLACE_* value. Never commit the resulting .env file.

# Deployment identity and approved immutable images (runtime configuration)
COMPOSE_PROJECT_NAME=blue-panda-production
CADDY_IMAGE=caddy:REPLACE_WITH_APPROVED_PINNED_VERSION
POSTGRES_IMAGE=postgres:REPLACE_WITH_APPROVED_PINNED_16_VERSION
STOREFRONT_IMAGE=registry.example.invalid/blue-panda/storefront:REPLACE_WITH_IMMUTABLE_TAG
MANAGEMENT_IMAGE=registry.example.invalid/blue-panda/management:REPLACE_WITH_IMMUTABLE_TAG
BACKEND_IMAGE=registry.example.invalid/blue-panda/backend:REPLACE_WITH_IMMUTABLE_TAG

# Public domains (runtime Caddy configuration; examples only)
SHOP_DOMAIN=shop.example.com
MANAGE_DOMAIN=manage.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL database configuration
# Option A (Standard): Single admin user for migrations and runtime
# Option B (Hardened Least-Privilege): POSTGRES_USER owns schema & runs Alembic;
# APP_DB_USER has DML-only (SELECT/INSERT/UPDATE/DELETE) permissions.
POSTGRES_DB=blue_panda
POSTGRES_USER=blue_panda_admin
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ADMIN_PASSWORD
APP_DB_USER=blue_panda_app
APP_DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_APP_PASSWORD
POSTGRES_MAX_CONNECTIONS=150
POSTGRES_SHARED_BUFFERS=256MB
# Runtime backend connects using the least-privilege user:
DATABASE_URL=postgresql+psycopg2://blue_panda_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@postgres:5432/blue_panda
# Migration admin URL (used by deploy/scripts/migrate-approved.sh):
# MIGRATION_DATABASE_URL=postgresql+psycopg2://blue_panda_admin:REPLACE_WITH_URL_ENCODED_ADMIN_PASSWORD@postgres:5432/blue_panda

# Redis distributed rate limiting (REDIS_PASSWORD is a required secret)
REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD
RATE_LIMIT_STORAGE_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_REDIS_PASSWORD@redis:6379/0
RATE_LIMIT_FAIL_OPEN=true

# FastAPI runtime configuration (JWT_SECRET_KEY is a required secret)
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_ISSUE_SESSION_TOKENS=false
CORS_ORIGINS=["https://shop.example.com","https://manage.example.com"]
BACKEND_WORKERS=2
TRUSTED_PROXY_IPS=172.16.0.0/12

# Account recovery & transactional email (SMTP or SendGrid)
EMAIL_PROVIDER=auto
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Blue Panda
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SENDGRID_API_KEY=
PASSWORD_RESET_EXPIRE_MINUTES=30
STOREFRONT_BASE_URL=https://shop.example.com
MANAGEMENT_BASE_URL=https://manage.example.com

# Digital card payments (Stripe — Credit / Debit Card + Cash on Delivery)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Durable cloud object storage (auto | local | supabase | s3)
UPLOAD_STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_PUBLIC_BASE_URL=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Image upload/runtime limits
MAX_REQUEST_BODY_SIZE=10MB
MAX_UPLOAD_SIZE_BYTES=5242880
MAX_IMAGE_DIMENSION=4096
MAX_IMAGE_PIXELS=16777216

# Next.js build-time public configuration.
# These values must be supplied while building each frontend image. Changing
# them here does not rewrite an already-built browser bundle.
NEXT_PUBLIC_API_URL=https://api.example.com/api
NEXT_PUBLIC_MANAGEMENT_URL=https://manage.example.com
NEXT_PUBLIC_STOREFRONT_URL=https://shop.example.com
NEXT_PUBLIC_MEDIA_HOSTS=

# Backup policy inputs for the future approved backup job. No backup service is
# included in this skeleton.
BACKUP_DESTINATION=REPLACE_WITH_ENCRYPTED_OFF_HOST_DESTINATION
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=REPLACE_WITH_APPROVED_SCHEDULE
BACKUP_ENCRYPTION_KEY_FILE=REPLACE_WITH_HOST_PATH_OUTSIDE_THE_REPOSITORY

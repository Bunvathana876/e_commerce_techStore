# ==========================================
# Blue Panda E-Commerce — Docker Compose Environment Template
# ==========================================
# Copy this file to .env before running Docker Compose if overriding defaults.
# DO NOT commit real secrets or production credentials to Git.

ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Connection Configuration
# ------------------------------------------------------------------------------
# Option A (Default for local dev): Connecting to PostgreSQL running on the Mac host
# (e.g. Homebrew PostgreSQL on port 5433). Docker containers reach the Mac via host.docker.internal.
# Note: If your password contains special characters like '@', URL-encode it (e.g. '%40').
DATABASE_URL=postgresql+psycopg2://ecommerce_user:CHANGE_ME_PASSWORD@host.docker.internal:5433/ecommerce_db

# Option B (Containerized DB): If running PostgreSQL inside Docker via:
#   docker compose --profile container-db up -d --build
# Uncomment the line below and set POSTGRES_* credentials:
# DATABASE_URL=postgresql+psycopg2://ecommerce_user:GoPassword_123!@postgres:5432/ecommerce_db
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=GoPassword_123!
POSTGRES_DB=ecommerce_db
POSTGRES_HOST_PORT=5432

# ------------------------------------------------------------------------------
# pgAdmin 4 UI
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@ecommerce.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ------------------------------------------------------------------------------
# FastAPI Backend Service
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=dev_secret_key_change_me_super_secure_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Safety & Migrations:
# Keep false to prevent accidental table creation, demo seeding, or auto-migrations.
# Run migrations manually via: docker compose run --rm backend alembic upgrade head
AUTO_INIT_DB=false
SEED_DEMO_DATA=false
RUN_MIGRATIONS_ON_STARTUP=false

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:3001","http://10.0.2.2:8000"]
ENABLE_DOCS_IN_PRODUCTION=false

# Account Recovery Email (SMTP or SendGrid)
EMAIL_PROVIDER=auto
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Blue Panda
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SENDGRID_API_KEY=
PASSWORD_RESET_EXPIRE_MINUTES=30
STOREFRONT_BASE_URL=http://localhost:3000
MANAGEMENT_BASE_URL=http://localhost:3001

# Digital Card Payments (Stripe — Credit / Debit Card + Cash on Delivery)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Durable Media Uploads (auto | local | supabase | s3)
UPLOAD_STORAGE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# Next.js Storefront & Management Apps
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_MANAGEMENT_URL=http://localhost:3001
